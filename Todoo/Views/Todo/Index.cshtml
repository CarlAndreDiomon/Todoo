@model List<TodoItem>
@{
    ViewData["Title"] = "To-Do List";
    int selectedId = 0;
    if (Context.Request.Query.ContainsKey("selectedId"))
    {
        int.TryParse(Context.Request.Query["selectedId"], out selectedId);
    }
    var selectedTask = Model.FirstOrDefault(x => x.Id == selectedId) ?? Model.FirstOrDefault();
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>
    /* ...[unchanged CSS from your code]... */
    body {
        background: #f6f6f6;
    }

    .todo-card {
        max-width: 900px;
        margin: 40px auto;
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.07);
        padding: 0;
        overflow: hidden;
    }

    .todo-content {
        display: flex;
        border-top: 1px solid #eee;
        min-height: 320px;
    }

    .todo-list-col {
        width: 270px;
        border-right: 1px solid #eee;
        padding: 32px 0 32px 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        background: #fff;
    }

    .todo-title {
        font-size: 2.2rem;
        font-weight: 800;
        margin-bottom: 24px;
        letter-spacing: -1px;
        width: 100%;
        text-align: left;
        padding-left: 32px;
    }

    .add-list-btn {
        font-size: 1.1rem;
        font-weight: 600;
        padding: 12px 32px;
        border-radius: 10px;
        background: #f6f6f6;
        border: none;
        color: #222;
        margin-bottom: 24px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.03);
        transition: background 0.2s;
    }

        .add-list-btn:hover {
            background: #ececec;
        }

    .task-list {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .task-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 0 24px;
        cursor: pointer;
        border-radius: 8px;
        transition: background 0.2s;
        min-height: 44px;
    }

        .task-item.selected, .task-item:hover {
            background: #f6f6f6;
        }

    .task-checkbox {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 2.5px solid #bbb;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        color: #198754;
        transition: border 0.2s, background 0.2s;
        flex-shrink: 0;
    }

        .task-checkbox.checked {
            background: #198754;
            border-color: #198754;
            color: #fff;
        }

    .task-title {
        font-size: 1.18rem;
        font-weight: 700;
        color: #222;
        word-break: break-word;
    }

    .todo-details-col {
        flex: 1;
        padding: 40px 40px 40px 40px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        background: #fff;
        position: relative;
    }

    .task-detail-title {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 0;
        letter-spacing: -1px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .task-detail-date {
        color: #7b7b7b;
        font-size: 1.2rem;
        margin-bottom: 18px;
        margin-top: 6px;
    }

    .task-detail-description {
        color: #444;
        font-size: 1.15rem;
        margin-top: 8px;
    }

    .menu-btn {
        background: #f6f6f6;
        border: none;
        border-radius: 10px;
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
        cursor: pointer;
        position: absolute;
        top: 0;
        right: 0;
    }

    .menu-dropdown {
        position: absolute;
        top: 44px;
        right: 0;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.10);
        min-width: 140px;
        z-index: 100;
        display: none;
        flex-direction: column;
        padding: 0;
    }

        .menu-dropdown.show {
            display: flex;
        }

        .menu-dropdown button {
            background: none;
            border: none;
            text-align: left;
            padding: 16px 20px;
            font-size: 1.15rem;
            font-weight: 600;
            color: #111;
            border-radius: 0;
            transition: background 0.15s;
        }

            .menu-dropdown button:hover {
                background: #f6f6f6;
            }

        .menu-dropdown .delete-btn {
            color: #d32f2f;
        }
</style>

<div class="todo-card">
    <div class="todo-content">
        <!-- Left: Task List -->
        <div class="todo-list-col">
            <div class="todo-title">ToDoo</div>
            <button class="add-list-btn" onclick="showAddTaskModal()">+ Add List</button>
            <div class="task-list">
                @foreach (var item in Model)
                {
                    <div class="task-item @(selectedTask != null && selectedTask.Id == item.Id ? "selected" : "")"
                         data-id="@item.Id"
                         onclick="selectTask(@item.Id)">
                        <div class="task-checkbox @(item.IsCompleted ? "checked" : "")"
                             onclick="event.stopPropagation();showCompleteModal(@item.Id, @item.IsCompleted)">
                            @if (item.IsCompleted)
                            {
                                <span>&#10003;</span>
                            }
                        </div>
                        <div class="task-title">@item.Title</div>
                    </div>
                }
            </div>
        </div>

        <!-- Right: Task Details -->
        <div class="todo-details-col">
            @if (selectedTask != null)
            {
                <div style="display: flex; align-items: flex-start; gap: 8px; position: relative;">
                    <span class="task-detail-title" id="taskTitleDisplay">@selectedTask.Title</span>
                    <button class="menu-btn" id="menuBtn" onclick="toggleMenu(event)">
                        <span style="font-size: 2rem; font-weight: bold;">&#8230;</span>
                    </button>
                    <div class="menu-dropdown" id="menuDropdown">
                        <button type="button" onclick="showEditTaskModal(@selectedTask.Id, '@selectedTask.Title.Replace("'", "\\'")', '@selectedTask.Description.Replace("'", "\\'")', '@selectedTask.Deadline.ToString("yyyy-MM-ddTHH:mm")', @selectedTask.IsCompleted.ToString().ToLower())">Edit</button>
                        <button type="button" class="delete-btn" onclick="confirmDelete(@selectedTask.Id)">Delete</button>
                    </div>

                </div>
                <div class="task-detail-date" id="taskDateDisplay">@selectedTask.Deadline.ToString("MMM dd, yyyy")</div>
                <div class="task-detail-description" id="taskDescDisplay">@selectedTask.Description</div>
            }
            else
            {
                <div class="text-muted">Select a task to view details.</div>
            }
        </div>
    </div>
</div>

<!-- Modals -->
<!-- Add Task Modal -->
<div class="modal fade" id="addTaskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Add" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Task</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Task Title</label>
                        <input name="Title" class="form-control" placeholder="Enter task title" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="Description" class="form-control" rows="3" placeholder="Enter task description"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Deadline</label>
                        <input name="Deadline" type="datetime-local" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Task</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Task Modal -->
<div class="modal fade" id="editTaskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Update" method="post">
                <input type="hidden" name="Id" id="editTaskId" />
                <div class="modal-header">
                    <h5 class="modal-title">Edit Task</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Task Title</label>
                        <input name="Title" id="editTitle" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="Description" id="editDescription" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Deadline</label>
                        <input name="Deadline" id="editDeadline" type="datetime-local" class="form-control" required />
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="editIsCompleted" name="IsCompleted" value="true" />
                        <label class="form-check-label" for="editIsCompleted">
                            Mark as Completed
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Delete">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="deleteId" name="id" />
                    <p>Are you sure you want to delete this task?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function selectTask(id) {
            window.location.href = `?selectedId=${id}`;
        }

        function showAddTaskModal() {
            const modal = new bootstrap.Modal(document.getElementById('addTaskModal'));
            modal.show();
        }

        function showEditTaskModal(id, title, desc, deadline, isCompleted) {
            document.getElementById('editTaskId').value = id;
            document.getElementById('editTitle').value = title;
            document.getElementById('editDescription').value = desc;
            document.getElementById('editDeadline').value = deadline;
            document.getElementById('editIsCompleted').checked = isCompleted;
            const modal = new bootstrap.Modal(document.getElementById('editTaskModal'));
            modal.show();
        }

        function confirmDelete(id) {
            document.getElementById('deleteId').value = id;
            const modal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
            modal.show();
        }

        function toggleMenu(event) {
            event.stopPropagation();
            const menu = document.getElementById('menuDropdown');
            menu.classList.toggle('show');
        }

        document.addEventListener('click', function (event) {
            const menu = document.getElementById('menuDropdown');
            if (menu && menu.classList.contains('show')) {
                menu.classList.remove('show');
            }
        });
    </script>
}
