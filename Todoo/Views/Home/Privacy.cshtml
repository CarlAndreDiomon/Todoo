@{
    ViewData["Title"] = "Privacy Page";
}

<div class="container ">
    <div class="card shadow-sm mx-auto" style="max-width: 720px;">
        <div class="card-body">
            <h4 class="card-title mb-3">Privacy Policy</h4>
            <p><strong>Last updated:</strong> May 18, 2025</p>
            <p>This Privacy Policy explains how we collect, use, and protect your personal information when using our To-Do List application.</p>

            <h5>Information We Collect</h5>
            <ul>
                <li><strong>Account Info:</strong> Email and password for registration.</li>
                <li><strong>Task Data:</strong> Titles, descriptions, deadlines, status.</li>
                <li><strong>Usage Data:</strong> App performance and interaction logs.</li>
            </ul>

            <h5>How We Use It</h5>
            <ul>
                <li>Account access and CRUD task management.</li>
                <li>Authentication and security.</li>
                <li>App improvements.</li>
            </ul>

            <h5>Data Security</h5>
            <p>We take reasonable steps to secure your information from unauthorized access or disclosure.</p>

            <h5>Data Sharing</h5>
            <p>We do <strong>not</strong> sell or trade your data. We only share it if legally required.</p>

            <h5>Your Rights</h5>
            <p>You can update, export, or delete your data anytime in the app.</p>

            <h5>Policy Updates</h5>
            <p>We may update this policy and inform you of changes within the app.</p>

            <h5>Contact</h5>
            <p>Questions? Email us at <a href="mailto:Soften@org.com">Soften@org.com</a>.</p>
        </div>
    </div>
</div>
