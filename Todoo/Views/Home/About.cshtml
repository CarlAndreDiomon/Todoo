@{
    ViewData["Title"] = "About";
}

<div class="container my-5" style="min-height: 70vh;">
    <div class="text-center">
        <h1 class="mb-4">Simple To-Do List Application</h1>
        <p class="lead text-muted mb-5">
            This web-based application is designed to help users stay organized and manage their daily tasks efficiently.
            It’s built with usability in mind—lightweight, intuitive, and responsive.
        </p>

        <h4 class="text-primary mb-3">Core Features</h4>
        <ul class="list-unstyled text-start mx-auto" style="max-width: 600px;">
            <li class="mb-2">
                <i class="bi bi-person-check-fill me-2 text-success"></i><strong>User Authentication:</strong> Secure login and registration.
            </li>
            <li class="mb-2">
                <i class="bi bi-list-task me-2 text-success"></i><strong>Task Management:</strong> Create, read, update, and delete to-do items.
            </li>
        </ul>

        <h5 class="text-secondary mt-4 mb-2">Upcoming Features</h5>
        <ul class="list-unstyled text-start mx-auto" style="max-width: 600px;">
            <li class="mb-1">
                <i class="bi bi-bell-fill me-2 text-warning"></i>Reminders and notifications for important tasks
            </li>
            <li class="mb-1">
                <i class="bi bi-bar-chart-fill me-2 text-warning"></i>Detailed task completion statistics and insights
            </li>
            <li class="mb-1">
                <i class="bi bi-people-fill me-2 text-warning"></i>Shared task lists and team collaboration tools
            </li>

        </ul>
    </div>

    <h3 class="text-center mt-5">👩‍💻 Meet the Developers</h3>
    <div class="row justify-content-center mt-4">
        <div class="col-md-3 text-center">
            <img src="/images/editor1.jpg" class="profile-avatar" style="object-fit: cover; aspect-ratio: 1 / 1;" alt="Leader" width="120" height="120">
            <h5>Carl Andre Diomon</h5>
            <p class="text-muted">Programmer</p>
        </div>
        <div class="col-md-3 text-center">
            <img src="/images/editor2.jpg" class="profile-avatar" style="object-fit: cover; aspect-ratio: 1 / 1;" alt="Member" width="120" height="120">
            <h5>Angelie May Casiano</h5>
            <p class="text-muted">Research and Project Structure</p>
        </div>
        <div class="col-md-3 text-center">
            <img src="/images/editor2.jpg" class="profile-avatar" style="object-fit: cover; aspect-ratio: 1 / 1;" alt="Member" width="120" height="120">
            <h5>Joy Melisa Segotier</h5>
            <p class="text-muted">Front-End Designer</p>
        </div>
        <div class="col-md-3 text-center">
            <img src="/images/editor2.jpg" class="profile-avatar" style="object-fit: cover; aspect-ratio: 1 / 1;" alt="Member" width="120" height="120">
            <h5>Christian James Cubon</h5>
            <p class="text-muted">Layout Designer</p>
        </div>
        <div class="col-md-3 text-center">
            <img src="/images/editor2.jpg" class="profile-avatar" style="object-fit: cover; aspect-ratio: 1 / 1;" alt="Member" width="120" height="120">
            <h5>Chinnie Aira Calibjo</h5>
            <p class="text-muted">Project Planner/FaultFinder</p>
        </div>
    </div>

</div>
